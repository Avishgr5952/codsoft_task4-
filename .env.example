# ==========================================
# MarketHub Environment Configuration Example
# ==========================================

# Backend Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api

# PostgreSQL Database Connection
# When using Docker Compose:
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/markethub?schema=public"
# When using local embedded postgres:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/markethub?schema=public"

# JWT Authentication
JWT_SECRET=markethub_super_secret_jwt_key_2026_dev
JWT_EXPIRES_IN=7d

# Redis Caching (Optional fallback to memory if not available)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# Marketplace Commission Settings
MARKETPLACE_COMMISSION_PERCENT=10

# AWS S3 Storage (Optional: fallback to local disk storage /uploads if not set)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=markethub-assets

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_NAME="MarketHub"
NEXT_PUBLIC_CURRENCY_SYMBOL="$"
